# Application
APP_NAME=Pomegranate Disease Detection
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=change-me-in-production

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=sqlite+aiosqlite:///./database/pomegranate.db

# Model
MODEL_PATH=./models/best_model.keras
IMG_SIZE=224
NUM_CLASSES=9
USE_WOA_MODEL=false

# Training
BATCH_SIZE=32
EPOCHS=50
LEARNING_RATE=0.001
DATASET_PATH=./dataset/processed

# WOA
WOA_POPULATION_SIZE=5
WOA_MAX_ITERATIONS=10

# Storage
UPLOAD_DIR=./uploads
GRADCAM_DIR=./static/gradcam
REPORTS_DIR=./static/reports
